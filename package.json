{
  "name": "vscode-github-copilot-controller",
  "displayName": "Controller for GitHub Copilot",
  "description": "Enables remote real-time control of GitHub Copilot from external apps",
  "version": "0.0.1",
  "publisher": "yuxi-labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuxi-Labs/vscode-github-copilot-controller"
  },
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "keywords": [
    "copilot",
    "remote",
    "chat",
    "controller"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilot-controller.start",
        "title": "Start",
        "category": "Copilot Controller"
      },
      {
        "command": "copilot-controller.stop",
        "title": "Stop",
        "category": "Copilot Controller"
      },
      {
        "command": "copilot-controller.showStatus",
        "title": "Show Status",
        "category": "Copilot Controller"
      },
      {
        "command": "copilot-controller.copyConnectionInfo",
        "title": "Copy Connection Info",
        "category": "Copilot Controller"
      },
      {
        "command": "copilot-controller.manageDevices",
        "title": "Manage Devices",
        "category": "Copilot Controller"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "copilotControllerConnections",
          "name": "Copilot Controller"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Controller",
      "properties": {
        "copilotController.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the controller when VS Code opens"
        },
        "copilotController.port": {
          "type": "number",
          "default": 3712,
          "description": "Port to listen on"
        },
        "copilotController.authToken": {
          "type": "string",
          "default": "",
          "description": "Authentication token (auto-generated if empty)"
        },
        "copilotController.tunnelUrl": {
          "type": "string",
          "default": "",
          "description": "External tunnel URL for remote access"
        },
        "copilotController.allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*"
          ],
          "description": "Allowed origins for CORS"
        },
        "copilotController.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Logging level (error, warn, info, debug)"
        },
        "copilotController.rateLimit": {
          "type": "object",
          "default": {
            "enabled": true,
            "maxRequests": 60,
            "windowSeconds": 60
          },
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "maxRequests": {
              "type": "number",
              "default": 60
            },
            "windowSeconds": {
              "type": "number",
              "default": 60
            }
          },
          "description": "Rate limiting configuration (max requests per window)"
        },
        "copilotController.maxQueueSize": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "Maximum number of messages to queue for offline clients"
        },
        "copilotController.ipAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "IP addresses or patterns allowed to connect (e.g., 192.168.1.*, 10.0.0.0/24). Empty = allow all."
        },
        "copilotController.ipBlocklist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "IP addresses or patterns blocked from connecting (takes precedence over allowlist)"
        },
        "copilotController.encryption": {
          "type": "object",
          "default": {
            "enabled": false,
            "key": null
          },
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "key": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            }
          },
          "description": "End-to-end encryption with AES-256-GCM (key must be 32 bytes hex)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "node-pty": "^1.1.0-beta9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@types/ws": "^8.5.13",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
